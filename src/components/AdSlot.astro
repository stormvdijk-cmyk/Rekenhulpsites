---
import { ADSENSE_CLIENT } from '../data/site';

interface Props {
  /** AdSense ad-unit-ID (data-ad-slot). Leeg = responsief blok zonder vaste unit. */
  slot: string;
  /** Gereserveerde minimale hoogte in px, voorkomt layout shift */
  minHeight?: number;
}
const { slot, minHeight = 280 } = Astro.props;
---
<aside class="ad" aria-label="Advertentie" style={`--ad-h:${minHeight}px`}>
  <span class="ad-label">Advertentie</span>
  {ADSENSE_CLIENT ? (
    <ins
      class="adsbygoogle ad-box"
      style="display:block"
      data-ad-client={ADSENSE_CLIENT}
      data-ad-slot={slot || undefined}
      data-ad-format="auto"
      data-full-width-responsive="true"
    ></ins>
  ) : (
    <div class="ad-placeholder" aria-hidden="true">Advertentieruimte</div>
  )}
</aside>
{ADSENSE_CLIENT && (
  <script is:inline>(window.adsbygoogle = window.adsbygoogle || []).push({});</script>
)}
