---
import Base from '../layouts/Base.astro';
import AdSlot from './AdSlot.astro';
import { AD_SLOTS, SITE, url } from '../data/site';
import { REKENHULPEN, rekenhulp } from '../data/calculators';
import { TARIEF_JAAR } from '../data/tarieven';

export interface Faq { vraag: string; antwoord: string }
interface Props {
  slug: string;
  title: string;
  description: string;
  h1: string;
  intro: string;
  faq: Faq[];
  /** Bron-URL voor de disclaimer; leeg = geen belastingdisclaimer */
  bron?: string;
  bronNaam?: string;
}
const { slug, title, description, h1, intro, faq, bron, bronNaam = 'Belastingdienst' } = Astro.props;
const r = rekenhulp(slug);
const verwant = r.verwant.map((s) => REKENHULPEN.find((x) => x.slug === s)!).slice(0, 3);
const pageUrl = new URL(url(`${slug}/`), Astro.site).href;
const home = new URL(url(''), Astro.site).href;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: h1,
    url: pageUrl,
    description,
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Alle (webbrowser)',
    inLanguage: 'nl-NL',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((f) => ({ '@type': 'Question', name: f.vraag, acceptedAnswer: { '@type': 'Answer', text: f.antwoord } })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: SITE.naam, item: home },
      { '@type': 'ListItem', position: 2, name: r.categorie, item: `${home}#${r.categorie.toLowerCase().replace(/[^a-z]+/g, '-')}` },
      { '@type': 'ListItem', position: 3, name: r.titel, item: pageUrl },
    ],
  },
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <nav class="breadcrumbs" aria-label="Kruimelpad">
    <ol>
      <li><a href={url('')}>{SITE.naam}</a></li>
      <li><a href={`${url('')}#${r.categorie.toLowerCase().replace(/[^a-z]+/g, '-')}`}>{r.categorie}</a></li>
      <li aria-current="page">{r.titel}</li>
    </ol>
  </nav>
  <h1>{h1}</h1>
  <p class="lead">{intro}</p>

  <slot name="calculator" />

  {bron && (
    <p class="disclaimer">
      Indicatie, geen financieel advies. Tarieven {TARIEF_JAAR}, bron: <a href={bron} rel="noopener" target="_blank">{bronNaam}</a>.
    </p>
  )}

  <slot name="vergelijking" />

  <AdSlot slot={AD_SLOTS.resultaat} minHeight={280} />

  <article class="prose">
    <slot name="uitleg-1" />
    <AdSlot slot={AD_SLOTS.midden} minHeight={280} />
    <slot name="uitleg-2" />

    <section class="faq">
      <h2>Veelgestelde vragen</h2>
      {faq.map((f) => (
        <details>
          <summary>{f.vraag}</summary>
          <p>{f.antwoord}</p>
        </details>
      ))}
    </section>
  </article>

  <section class="related" aria-labelledby="verwant">
    <h2 id="verwant">Verwante rekenhulpen</h2>
    <ul class="cards">
      {verwant.map((v) => (
        <li><a class="card" href={url(`${v.slug}/`)}><strong>{v.titel}</strong><span>{v.kort}</span></a></li>
      ))}
    </ul>
  </section>

  <AdSlot slot={AD_SLOTS.onder} minHeight={250} />
</Base>
