---
import CalculatorPage from '../components/CalculatorPage.astro';
import Field from '../components/Field.astro';
import { tarieven } from '../data/tarieven';
const t = tarieven;
const a = t.aow;
const pct = (n: number) => (n * 100).toLocaleString('nl-NL', { maximumFractionDigits: 3 }) + '%';
const eur = (n: number) => '€ ' + n.toLocaleString('nl-NL');
const faq = [
  { vraag: 'Krijg ik geld terug van de Belastingdienst?', antwoord: 'Dat hangt af van hoeveel loonheffing er al is ingehouden. Je werkgever of uitkeringsinstantie houdt per maand belasting in. Zijn je aftrekposten hoog, of heb je een deel van het jaar niet gewerkt, dan is er vaak te veel ingehouden en krijg je geld terug. Vul de ingehouden loonheffing van je jaaropgaaf in om dat te schatten.' },
  { vraag: 'Waarom moet ik bijbetalen terwijl mijn werkgever belasting inhoudt?', antwoord: 'Meestal omdat je bij twee werkgevers of uitkeringen tegelijk de loonheffingskorting liet toepassen. Je kortingen tellen dan dubbel mee in de loonheffing, maar in de aangifte maar één keer. Ook een flinke loonsverhoging of bonus kan zorgen dat de afbouw van je kortingen pas in de aangifte zichtbaar wordt.' },
  { vraag: 'Wat zijn aftrekposten in box 1?', antwoord: 'Bijvoorbeeld hypotheekrente (minus het eigenwoningforfait), lijfrentepremie, giften aan goede doelen boven de drempel en specifieke zorgkosten. Ze verlagen je belastbaar inkomen. Bij een inkomen in de hoogste schijf leveren de meeste aftrekposten maximaal 37,56% op.' },
  { vraag: 'Wat verandert er als ik de AOW-leeftijd heb?', antwoord: `Je betaalt geen AOW-premie meer, dus de eerste schijf is ${pct(a.schijven[0].tarief)} in plaats van ${pct(t.box1.schijven[0].tarief)}. De algemene heffingskorting en de arbeidskorting zijn ongeveer gehalveerd, maar je krijgt ouderenkorting (maximaal ${eur(a.ouderenkorting.maximum)}) en als alleenstaande nog ${eur(a.alleenstaandeOuderenkorting)} extra.` },
];
---
<CalculatorPage
  slug="inkomstenbelasting-berekenen"
  title="Inkomstenbelasting berekenen 2026"
  description="Bereken je inkomstenbelasting over 2026 in box 1: loon, winst, pensioen en aftrekposten, met alle heffingskortingen. Ook voor AOW'ers."
  h1="Inkomstenbelasting berekenen"
  intro="Vul je jaarinkomen en eventuele aftrekposten in. Je ziet direct hoeveel inkomstenbelasting je over 2026 betaalt, en of je geld terugkrijgt."
  faq={faq}
  bron={t.box1.bron}
>
  <form slot="calculator" class="calc" id="f" novalidate>
    <div class="result" aria-live="polite">
      <p class="result-label" id="r-label">Inkomstenbelasting 2026</p>
      <p class="result-main" id="r-bel">–</p>
      <p class="result-sub" id="r-saldo"></p>
      <dl>
        <dt>Belastbaar inkomen box 1</dt><dd id="r-ink">–</dd>
        <dt>Belasting vóór kortingen</dt><dd id="r-bruto">–</dd>
        <dt>Algemene heffingskorting</dt><dd id="r-ahk">–</dd>
        <dt>Arbeidskorting</dt><dd id="r-ak">–</dd>
        <dt>Ouderenkortingen</dt><dd id="r-ouk">–</dd>
        <dt>Gemiddeld / marginaal tarief</dt><dd id="r-tarief">–</dd>
      </dl>
    </div>
    <div class="form">
      <Field id="loon" label="Bruto loon per jaar" value="45360" prefix="€" hint="Inclusief vakantiegeld, bonussen en bijtelling; na pensioenpremie (zie je jaaropgaaf)" />
      <Field id="winst" label="Winst uit onderneming" value="0" prefix="€" hint="Na ondernemersaftrek en mkb-winstvrijstelling" />
      <Field id="overig" label="AOW, pensioen, uitkering en overig inkomen" value="0" prefix="€" />
      <Field id="aftrek" label="Aftrekposten" value="0" prefix="€" hint="Bijv. hypotheekrente min eigenwoningforfait, giften, zorgkosten" />
      <Field id="lh" label="Al ingehouden loonheffing (optioneel)" value="" prefix="€" hint="Staat op je jaaropgaaf; voor een schatting van je teruggave" />
      <label class="check"><input type="checkbox" id="aow" name="aow" /> Ik heb het hele jaar de AOW-leeftijd</label>
      <label class="check" id="al-wrap" hidden><input type="checkbox" id="alleen" name="alleen" /> Ik ben alleenstaand (alleenstaande-ouderenkorting)</label>
    </div>
  </form>

  <Fragment slot="uitleg-1">
    <h2>Zo wordt je inkomstenbelasting berekend</h2>
    <p>In box 1 telt de Belastingdienst al je inkomen uit werk en woning op: loon, winst, pensioen, AOW en uitkeringen. Daar gaan je aftrekposten af. Over wat overblijft betaal je belasting in schijven:</p>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Inkomen</th><th>Jonger dan AOW-leeftijd</th><th>AOW-leeftijd</th></tr></thead>
        <tbody>
          <tr><td>tot {eur(t.box1.schijven[0].tot!)}</td><td>{pct(t.box1.schijven[0].tarief)}</td><td>{pct(a.schijven[0].tarief)}</td></tr>
          <tr><td>{eur(t.box1.schijven[0].tot!)} – {eur(t.box1.schijven[1].tot!)}</td><td>{pct(t.box1.schijven[1].tarief)}</td><td>{pct(a.schijven[1].tarief)}</td></tr>
          <tr><td>boven {eur(t.box1.schijven[1].tot!)}</td><td>{pct(t.box1.schijven[2].tarief)}</td><td>{pct(a.schijven[2].tarief)}</td></tr>
        </tbody>
      </table>
    </div>
    <p>Daarna gaan de heffingskortingen eraf. De <strong>algemene heffingskorting</strong> krijgt iedereen; die daalt boven {eur(t.algemeneHeffingskorting.afbouwVanaf)}. De <strong>arbeidskorting</strong> hangt alleen af van je arbeidsinkomen, dus loon en winst, niet van je aftrekposten. AOW'ers krijgen ook <strong>ouderenkorting</strong>, die tussen {eur(a.ouderenkorting.afbouwVanaf)} en ongeveer € 59.782 afloopt naar nul. Kortingen kunnen je belasting niet onder nul brengen.</p>

    <h2>Rekenvoorbeelden</h2>
    <div class="voorbeeld">
      <p><strong>Werknemer:</strong> je verdient € 45.360 per jaar, inclusief vakantiegeld. De belasting vóór kortingen is € 16.333,43. Daar gaan € 2.115,38 algemene heffingskorting en € 5.680,54 arbeidskorting af. Je betaalt <strong>€ 8.537,51</strong>. Heeft je werkgever € 9.000 ingehouden, dan krijg je ongeveer € 462,49 terug.</p>
      <p><strong>Met aftrekposten:</strong> je verdient € 50.000 en hebt € 5.000 aftrekposten. Je belastbaar inkomen is € 45.000, maar de arbeidskorting gaat uit van € 50.000 (€ 5.398,04). Je betaalt <strong>€ 8.661,77</strong>.</p>
      <p><strong>Gepensioneerd:</strong> je bent alleenstaand en hebt € 30.000 aan AOW en pensioen. De belasting is 17,85% × € 30.000 = € 5.355. Na € 1.547,57 algemene heffingskorting, € 2.067 ouderenkorting en € 540 alleenstaande-ouderenkorting betaal je <strong>€ 1.200,43</strong>.</p>
    </div>
  </Fragment>

  <Fragment slot="uitleg-2">
    <h2>Wat deze berekening niet meeneemt</h2>
    <ul>
      <li><strong>Box 2 en box 3.</strong> Inkomen uit een aanmerkelijk belang en uit sparen en beleggen telt apart. Reken box 3 uit met <a href="../box-3-belasting-berekenen/">box 3-belasting berekenen</a>. Box 2 en 3 tellen wel mee in het verzamelinkomen dat de algemene heffingskorting bepaalt; dat zit hier niet in.</li>
      <li><strong>Andere kortingen.</strong> De inkomensafhankelijke combinatiekorting (voor ouders van kinderen geboren vóór 2025) en de jonggehandicaptenkorting zitten er niet in.</li>
      <li><strong>AOW in de loop van het jaar.</strong> Bereik je in 2026 de AOW-leeftijd, dan ligt het tarief in de eerste schijf tussen 17,85% en 35,75%, afhankelijk van je geboortemaand. Ben je geboren vóór 1946, dan loopt je eerste schijf door tot € 41.123.</li>
      <li><strong>Aftrekbeperking.</strong> In de hoogste schijf leveren aftrekposten maximaal 37,56% op. Bij hoge inkomens met grote aftrekposten valt de echte belasting dus iets hoger uit.</li>
    </ul>
    <p>Wil je juist weten wat er per maand netto overblijft? Gebruik <a href="../netto-salaris-berekenen/">netto salaris berekenen</a>. Heb je een eigen bedrijf, kijk dan bij <a href="../zzp-netto-inkomen-berekenen/">zzp netto inkomen</a>.</p>
  </Fragment>
</CalculatorPage>

<script>
  import { berekenInkomstenbelasting } from '../lib/calculators/inkomstenbelasting';
  import { formatProcent, parseGetal } from '../lib/calculators/format';
  import { $, euro, getal, live, vinkje, zet } from '../lib/ui';
  live('f', () => {
    const aow = vinkje('aow');
    $('al-wrap').hidden = !aow;
    const lhRuw = parseGetal(($('lh') as HTMLInputElement).value);
    const r = berekenInkomstenbelasting({
      loon: getal('loon'), winst: getal('winst'), overigInkomen: getal('overig'), aftrekposten: getal('aftrek'),
      aow, alleenstaand: aow && vinkje('alleen'), ingehoudenLoonheffing: Number.isFinite(lhRuw) ? lhRuw : undefined,
    });
    zet('r-bel', euro(r.teBetalen));
    zet('r-saldo', r.saldo === null ? 'Vul de ingehouden loonheffing in om je teruggave te schatten' : r.saldo >= 0 ? `Je krijgt ongeveer ${euro(r.saldo)} terug` : `Je betaalt ongeveer ${euro(-r.saldo)} bij`);
    zet('r-ink', euro(r.belastbaarInkomen));
    zet('r-bruto', euro(r.brutoBelasting));
    zet('r-ahk', euro(r.algemeneHeffingskorting));
    zet('r-ak', euro(r.arbeidskorting));
    zet('r-ouk', euro(r.ouderenkorting + r.alleenstaandeOuderenkorting));
    zet('r-tarief', `${formatProcent(r.gemiddeldTarief, 1)} / ${formatProcent(r.marginaalTarief)}`);
  });
</script>
