---
import CalculatorPage from '../components/CalculatorPage.astro';
import Field from '../components/Field.astro';
import { tarieven } from '../data/tarieven';
const e = tarieven.energiebelasting;
const eur5 = (n: number) => '€ ' + n.toLocaleString('nl-NL', { minimumFractionDigits: 5 });
const eur2 = (n: number) => '€ ' + n.toLocaleString('nl-NL', { minimumFractionDigits: 2 });
const faq = [
  { vraag: 'Hoeveel energiebelasting betaal ik per kWh in 2026?', antwoord: `${eur5(e.elektriciteit[0].tarief)} per kWh tot 10.000 kWh, exclusief btw. Met 21% btw is dat ongeveer € ${(e.elektriciteit[0].tarief * 1.21).toLocaleString('nl-NL', { maximumFractionDigits: 4 })} per kWh. In 2025 was het ${eur5(e.vorigJaar.elektriciteit)}.` },
  { vraag: 'Hoeveel energiebelasting betaal ik per m³ gas?', antwoord: `${eur5(e.gas[0].tarief)} per m³ tot 170.000 m³, exclusief btw. Met btw is dat ongeveer € ${(e.gas[0].tarief * 1.21).toLocaleString('nl-NL', { maximumFractionDigits: 4 })} per m³.` },
  { vraag: 'Wat is de belastingvermindering?', antwoord: `Een vast bedrag dat je energieleverancier van je energiebelasting aftrekt, omdat een deel van het verbruik als basisbehoefte geldt. In 2026 is dat ${eur2(e.vermindering)} per jaar per elektriciteitsaansluiting, exclusief btw. Je krijgt het alleen voor een woning of ander pand met een verblijfsfunctie.` },
  { vraag: 'Hoe zit het met zonnepanelen?', antwoord: 'Stroom die je zelf opwekt met bijvoorbeeld zonnepanelen en zelf gebruikt, is vrij van energiebelasting. Vul daarom het verbruik in waarover je leverancier energiebelasting rekent; dat staat op je jaarafrekening.' },
];
---
<CalculatorPage
  slug="energiebelasting-berekenen"
  title="Energiebelasting berekenen 2026"
  description="Bereken hoeveel energiebelasting je in 2026 betaalt over stroom en gas, met de belastingvermindering en 21% btw. Tarieven per kWh en m³."
  h1="Energiebelasting berekenen"
  intro="Vul je jaarverbruik van stroom en gas in. Je ziet hoeveel energiebelasting er op je energierekening staat."
  faq={faq}
  bron={e.bron}
>
  <form slot="calculator" class="calc" id="f" novalidate>
    <div class="result" aria-live="polite">
      <p class="result-label">Energiebelasting per jaar (incl. btw)</p>
      <p class="result-main" id="r-totaal">–</p>
      <p class="result-sub">Per maand <strong id="r-maand">–</strong></p>
      <dl>
        <dt>Belasting op stroom</dt><dd id="r-el">–</dd>
        <dt>Belasting op gas</dt><dd id="r-gas">–</dd>
        <dt>Belastingvermindering</dt><dd id="r-verm">–</dd>
        <dt>Totaal exclusief btw</dt><dd id="r-ex">–</dd>
        <dt>Btw (21%)</dt><dd id="r-btw">–</dd>
      </dl>
    </div>
    <div class="form">
      <div class="row-2 stack">
        <Field id="kwh" label="Stroomverbruik per jaar" value="2500" suffix="kWh" hint="Zoals op je jaarafrekening" />
        <Field id="m3" label="Gasverbruik per jaar" value="1000" suffix="m³" hint="0 als je geen gas hebt" />
      </div>
      <label class="check"><input type="checkbox" id="verblijf" name="verblijf" checked /> Het is een woning (verblijfsfunctie)</label>
    </div>
  </form>

  <Fragment slot="uitleg-1">
    <h2>Zo werkt de energiebelasting</h2>
    <p>Over elke kWh stroom en elke m³ aardgas betaal je energiebelasting. Je energieleverancier rekent die met je af en draagt hem af aan de Belastingdienst. De tarieven gaan omlaag naarmate je meer verbruikt; voor huishoudens geldt bijna altijd de eerste schijf.</p>
    <div class="table-wrap"><table>
      <thead><tr><th scope="col">Tarief 2026 (excl. btw)</th><th scope="col">Per eenheid</th></tr></thead>
      <tbody>
        <tr><td>Stroom tot 10.000 kWh</td><td>{eur5(e.elektriciteit[0].tarief)}</td></tr>
        <tr><td>Stroom 10.001 t/m 50.000 kWh</td><td>{eur5(e.elektriciteit[1].tarief)}</td></tr>
        <tr><td>Gas tot 170.000 m³</td><td>{eur5(e.gas[0].tarief)}</td></tr>
        <tr><td>Vermindering per aansluiting per jaar</td><td>{eur2(e.vermindering)}</td></tr>
      </tbody>
    </table></div>
    <p>Daarna trekt je leverancier de <strong>belastingvermindering</strong> van {eur2(e.vermindering)} af. Over het totaal komt nog 21% btw.</p>

    <h2>Rekenvoorbeeld</h2>
    <div class="voorbeeld">
      <p>Je gebruikt <strong>2.500 kWh stroom</strong> en <strong>1.000 m³ gas</strong> per jaar.</p>
      <ul>
        <li>Stroom: 2.500 × € 0,09161 = € 229,03</li>
        <li>Gas: 1.000 × € 0,60066 = € 600,66</li>
        <li>Min vermindering: € 829,69 − € 519,80 = € 309,89</li>
        <li>Plus 21% btw: <strong>€ 374,96 per jaar</strong>, ongeveer € 31 per maand</li>
      </ul>
    </div>
  </Fragment>

  <Fragment slot="uitleg-2">
    <h2>Wat zit er nog meer op je energierekening?</h2>
    <p>De energiebelasting is maar een deel van je rekening. Daarnaast betaal je de leveringskosten van je leverancier (de prijs per kWh en m³), vaste leveringskosten en netbeheerkosten. Over al die onderdelen komt ook btw. Deze rekenhulp rekent alleen de belasting uit, zodat je ziet welk deel van je rekening naar de overheid gaat.</p>
    <p>Gas is per eenheid veel zwaarder belast dan stroom. Daarom levert een warmtepomp of een beter geïsoleerd huis vaak extra op: je bespaart op gas en betaalt over de extra stroom minder belasting. De opslag duurzame energie (ODE) is sinds 2023 op € 0 gezet.</p>
    <p>Wil je zien wat de btw op een bedrag is? Gebruik <a href="../btw-berekenen/">btw berekenen</a>. Benieuwd hoeveel je energierekening in koopkracht is gestegen? Kijk bij <a href="../inflatie-berekenen/">inflatie berekenen</a>.</p>
  </Fragment>
</CalculatorPage>

<script>
  import { berekenEnergiebelasting } from '../lib/calculators/energiebelasting';
  import { euro, getal, live, vinkje, zet } from '../lib/ui';
  live('f', () => {
    const r = berekenEnergiebelasting({ kwh: getal('kwh'), m3: getal('m3'), verblijfsfunctie: vinkje('verblijf') });
    zet('r-totaal', euro(r.totaalInclBtw));
    zet('r-maand', euro(r.perMaand));
    zet('r-el', euro(r.elektriciteit));
    zet('r-gas', euro(r.gas));
    zet('r-verm', r.vermindering ? '− ' + euro(r.vermindering) : '–');
    zet('r-ex', euro(r.totaalExBtw));
    zet('r-btw', euro(r.btw));
  });
</script>
