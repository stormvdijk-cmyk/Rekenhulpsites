---
import Base from '../layouts/Base.astro';
import { ONDERWERPEN, REKENHULPEN, type Rekenhulp } from '../data/calculators';
import { SITE, url } from '../data/site';
import { TARIEF_JAAR } from '../data/tarieven';

const home = new URL(url(''), Astro.site).href;
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebSite', name: SITE.naam, url: home, inLanguage: 'nl-NL' },
  {
    '@context': 'https://schema.org', '@type': 'ItemList',
    itemListElement: REKENHULPEN.map((r, i) => ({ '@type': 'ListItem', position: i + 1, name: r.titel, url: new URL(url(`${r.slug}/`), Astro.site).href })),
  },
];
const anker = (c: string) => c.toLowerCase().replace(/[^a-z]+/g, '-');

// Volgorde binnen een onderwerp: meest gezochte eerst.
const VOORRANG = [
  'netto-salaris-berekenen', 'bruto-netto-uurloon', 'vakantiegeld-berekenen', 'minimumloon-berekenen', 'ww-uitkering-berekenen',
  'inkomstenbelasting-berekenen', 'box-3-belasting-berekenen', 'combinatiekorting-berekenen',
  'hypotheek-maandlasten-berekenen', 'overdrachtsbelasting-berekenen',
  'samengestelde-rente', 'spaardoel-berekenen', 'lening-maandlasten', 'inflatie-berekenen',
  'zzp-uurtarief-berekenen', 'zzp-netto-inkomen-berekenen', 'btw-berekenen',
  'schenkbelasting-berekenen', 'erfbelasting-berekenen',
];
const rang = (r: Rekenhulp) => { const i = VOORRANG.indexOf(r.slug); return i === -1 ? 99 : i; };
const perOnderwerp = ONDERWERPEN.map((o) => ({ ...o, items: REKENHULPEN.filter((r) => r.categorie === o.naam).sort((a, b) => rang(a) - rang(b)) }));

const POPULAIR = ['netto-salaris-berekenen', 'inkomstenbelasting-berekenen', 'btw-berekenen', 'vakantiegeld-berekenen', 'hypotheek-maandlasten-berekenen', 'box-3-belasting-berekenen'];
const populair = POPULAIR.map((s) => REKENHULPEN.find((r) => r.slug === s)!).filter(Boolean);
const zoektekst = (r: Rekenhulp) => `${r.titel} ${r.kort} ${r.trefwoorden} ${r.categorie}`.toLowerCase();
---
<Base title={`Rekenhulp – gratis financiële rekenhulpen ${TARIEF_JAAR}`} description={`${REKENHULPEN.length} gratis rekenhulpen voor salaris, belasting, wonen, sparen en ondernemen, met de tarieven van ${TARIEF_JAAR}. Snel, ook offline.`} jsonLd={jsonLd}>
  <section class="home-hero">
    <h1>Financiële rekenhulpen</h1>
    <p class="lead">{REKENHULPEN.length} gratis rekenhulpen voor je geldzaken, met de officiële tarieven van {TARIEF_JAAR}. Je vult in, de uitkomst staat er meteen.</p>
    <div class="home-search">
      <label for="zoek" class="visually-hidden">Zoek een rekenhulp</label>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M20 20l-4-4"/></svg>
      <input type="search" id="zoek" placeholder="Zoek, bijv. netto of btw" autocomplete="off" />
    </div>
    <nav class="home-chips" aria-label="Onderwerpen">
      {perOnderwerp.map((o) => <a href={`#${anker(o.naam)}`}>{o.naam} <span>{o.items.length}</span></a>)}
    </nav>
  </section>

  <section class="home-popular" data-populair aria-labelledby="h-populair">
    <h2 id="h-populair">Meest gebruikt</h2>
    <ul>
      {populair.map((r) => (
        <li><a href={url(`${r.slug}/`)}><strong>{r.titel}</strong><span class="kort">{r.kort}</span></a></li>
      ))}
    </ul>
  </section>

  <div class="home-topics">
    {perOnderwerp.map((o) => (
      <section class="topic" id={anker(o.naam)} data-topic aria-labelledby={`h-${anker(o.naam)}`}>
        <header>
          <span class="topic-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d={o.icoon} /></svg></span>
          <div>
            <h2 id={`h-${anker(o.naam)}`}>{o.naam}</h2>
            <p>{o.omschrijving}</p>
          </div>
        </header>
        <ul>
          {o.items.map((r) => (
            <li data-zoek={zoektekst(r)}>
              <a href={url(`${r.slug}/`)}>
                <span class="t"><strong>{r.titel}</strong><span>{r.kort}</span></span>
                <svg class="chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
              </a>
            </li>
          ))}
        </ul>
        {o.naam === 'Belastingen' && (
          <a class="topic-extra" href={url(`belastingtarieven-${TARIEF_JAAR}/`)}>Alle belastingtarieven {TARIEF_JAAR} op een rij →</a>
        )}
      </section>
    ))}
  </div>
  <p class="no-results" id="geen" hidden>Geen rekenhulp gevonden. Probeer een ander woord, zoals "loon", "belasting" of "huis".</p>

  <section class="home-about">
    <h2>Waarom deze rekenhulpen?</h2>
    <div class="home-about-grid">
      <div><h3>Officiële tarieven</h3><p>Belastingtarieven, kortingen en grenzen komen van de Belastingdienst, de Rijksoverheid, het UWV en het CBS. Bij elke rekenhulp staat de bron.</p></div>
      <div><h3>Uitleg erbij</h3><p>Elke rekenhulp laat zien hoe de uitkomst tot stand komt, met een uitgewerkt voorbeeld. Zo kun je het zelf nakijken.</p></div>
      <div><h3>Je gegevens blijven bij jou</h3><p>Alles wordt in je eigen browser uitgerekend. We slaan niets op een server op. Installeer de site als app, dan werkt hij ook offline.</p></div>
    </div>
  </section>

  <script>
    const zoek = document.getElementById('zoek') as HTMLInputElement;
    const items = [...document.querySelectorAll<HTMLElement>('[data-zoek]')];
    const topics = [...document.querySelectorAll<HTMLElement>('[data-topic]')];
    const populair = document.querySelector<HTMLElement>('[data-populair]')!;
    const geen = document.getElementById('geen')!;
    zoek.addEventListener('input', () => {
      const q = zoek.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      let n = 0;
      items.forEach((li) => { const ok = q.every((w) => li.dataset.zoek!.includes(w)); li.hidden = !ok; if (ok) n++; });
      topics.forEach((t) => { t.hidden = !t.querySelector('[data-zoek]:not([hidden])'); });
      populair.hidden = q.length > 0;
      geen.hidden = n > 0;
    });
  </script>
</Base>
