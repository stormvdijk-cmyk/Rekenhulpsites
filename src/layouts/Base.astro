---
import '../styles/global.css';
import { ADSENSE_CLIENT, ANALYTICS, SITE, url } from '../data/site';

interface Props {
  title: string;
  description: string;
  jsonLd?: object[];
  noindex?: boolean;
  /** bredere pagina (homepage) */
  wide?: boolean;
}
const { title, description, jsonLd = [], noindex = false, wide = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title.includes(SITE.naam) ? title : `${title} | ${SITE.naam}`;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="nl">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex" />}
  <meta name="theme-color" content="#0f4c5c" />
  <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
  <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
  <link rel="manifest" href={url('manifest.webmanifest')} />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="nl_NL" />
  <meta property="og:site_name" content={SITE.naam} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <script is:inline>
    try { var t = localStorage.getItem('theme'); if (t) document.documentElement.dataset.theme = t; } catch (e) {}
  </script>
  {ADSENSE_CLIENT && (
    <>
      {/* Google Consent Mode v2: alles standaard geweigerd tot de Google-CMP toestemming doorgeeft. */}
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('consent', 'default', {
          ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
          analytics_storage: 'denied', wait_for_update: 500
        });
        gtag('set', 'ads_data_redaction', true);
      </script>
      <script async src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`} crossorigin="anonymous"></script>
      <meta name="google-adsense-account" content={ADSENSE_CLIENT} />
    </>
  )}
  {jsonLd.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
</head>
<body>
  <a class="skip" href="#inhoud">Naar de inhoud</a>
  <header class="site-header">
    <div class:list={["wrap", { wide }]}>
      <a class="logo" href={base}>
        <svg viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="#0f4c5c"/><rect x="16" y="12" width="32" height="40" rx="5" fill="#fff"/><rect x="21" y="17" width="22" height="9" rx="2" fill="#2a9d8f"/><g fill="#0f4c5c"><circle cx="24" cy="33" r="2.6"/><circle cx="32" cy="33" r="2.6"/><circle cx="40" cy="33" r="2.6"/><circle cx="24" cy="42" r="2.6"/><circle cx="32" cy="42" r="2.6"/><circle cx="40" cy="42" r="2.6"/></g></svg>
        {SITE.naam}
      </a>
      <nav class="header-nav" aria-label="Hoofdmenu">
        <a href={base}>Alle rekenhulpen</a>
        <button class="theme-toggle" type="button" aria-label="Wissel licht/donker thema" id="theme-toggle">
          <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 3a9 9 0 1 0 9 9 7 7 0 0 1-9-9Z"/></svg>
        </button>
      </nav>
    </div>
  </header>
  <main id="inhoud" class:list={["wrap", { wide }]}>
    <slot />
  </main>
  <footer class="site-footer">
    <div class:list={["wrap", { wide }]}>
      <nav aria-label="Voettekst">
        <a href={url('belastingtarieven-2026/')}>Belastingtarieven 2026</a>
        <a href={url('over/')}>Over</a>
        <a href={url('contact/')}>Contact</a>
        <a href={url('privacy/')}>Privacy</a>
        <a href={url('cookies/')}>Cookies</a>
        <a href={url('disclaimer/')}>Disclaimer</a>
      </nav>
      <p>© {new Date().getFullYear()} {SITE.naam}. Uitkomsten zijn een indicatie, geen financieel advies.</p>
    </div>
  </footer>
  <script>
    import { registerSW } from 'virtual:pwa-register';
    registerSW({ immediate: true });
    const btn = document.getElementById('theme-toggle');
    btn?.addEventListener('click', () => {
      const root = document.documentElement;
      const isDark = root.dataset.theme ? root.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
      const next = isDark ? 'light' : 'dark';
      root.dataset.theme = next;
      try { localStorage.setItem('theme', next); } catch (e) {}
    });
  </script>
  {ANALYTICS.cloudflareToken && (
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: ANALYTICS.cloudflareToken })}></script>
  )}
  {ANALYTICS.goatcounter && (
    <script async data-goatcounter={`https://${ANALYTICS.goatcounter}.goatcounter.com/count`} src="https://gc.zgo.at/count.js"></script>
  )}
</body>
</html>
